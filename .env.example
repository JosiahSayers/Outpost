DATABASE_URL=
PORT=3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
REDIS_URL=valkey://localhost:6379
RESEND_API_KEY=
SENTRY_DSN=
MODEL_ACCESS_KEY=
# VAPID keypair for Web Push (BTP-112 Phase 2). Generate a pair with
# `bunx --bun web-push generate-vapid-keys`. The private key is server-only;
# the public key also needs setting as BUN_PUBLIC_VAPID_PUBLIC_KEY below.
VAPID_PRIVATE_KEY=
# Cloudflare R2 storage for scraped public-meal-catalog product images
# (BTP-107). Optional locally -- image handling logs and skips rather than
# failing the whole import when these aren't set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET__IMAGES=
R2_BUCKET__USER_UPLOADS=
# Public base URL public-catalog images are served from (BTP-111's
# publicMealItemSummary transformer); unused by the import job itself, but
# part of the same storage setup.
R2_PUBLIC_BASE_URL=
# Differs from NODE_ENV, which is only develpment or production
ENVIRONMENT=
# Frontend equivalents — inlined into the client bundle at build time via
# bunfig.toml's [serve.static] env config (dev) and the Dockerfile's
# `bun build --env` flag (prod). Must be prefixed BUN_PUBLIC_ to be exposed
# to browser code.
BUN_PUBLIC_SENTRY_DSN=
BUN_PUBLIC_ENVIRONMENT=
BUN_PUBLIC_VAPID_PUBLIC_KEY=
