// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  engineType      = "client"
  runtime         = "bun"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

//
// Production Seed Data
//
model AppliedSeeds {
  id        String   @id @default(uuid())
  name      String   @unique
  appliedAt DateTime @default(now())
}

//
// User and auth
//
model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  gearInventoryItems GearInventoryItem[]
  gearCategories     GearCategory[]
  packingLists       PackingList[]
  trips              Trip[]
  mealPlanItems      MealPlanItem[]

  role                            String?
  banned                          Boolean?                 @default(false)
  banReason                       String?
  banExpires                      DateTime?
  twoFactorEnabled                Boolean?                 @default(false)
  twoFactors                      TwoFactor[]
  accountSettingValues            AccountSettingValue[]
  communicationAuditLogsInitiated CommunicationAuditLog[]  @relation("initiatedBy")
  communicationAuditLogsReceived  CommunicationAuditLog[]  @relation("recipient")
  protectedAreaIngestRuns         ProtectedAreaIngestRun[]
  notifications                   Notification[]
  feedback                        Feedback[]
  feedbackNotes                   FeedbackNote[]
  feedbackAuditLogs               FeedbackAuditLog[]
  ignoredPublicMealItems          IgnoredPublicMealItem[]
  tripPartyMembers                TripPartyMember[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model TwoFactor {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())

  @@index([userId])
  @@map("two_factor")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

//
// User Feedback
//
enum FeedbackStatus {
  new // just submitted, unreviewed
  triaged // reviewed by an admin, confirmed valid/actionable
  planned // accepted, scheduled but not started
  in_progress // actively being worked (researching + implementing collapsed)
  completed // resolved — bug fixed or feature added, topic tells you which
  declined // won't fix / not planned, reviewed and rejected
  duplicate // duplicate of existing feedback
}

model Feedback {
  id          String   @id @default(uuid())
  referenceId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  text            String
  inferredTopic   String[]
  inferredSubject String[]
  status          FeedbackStatus @default(new)
  submittedOnPage String

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  duplicateOf       Feedback?          @relation("duplicate-feedback", fields: [duplicateId], references: [id], onDelete: SetNull)
  duplicateId       String?
  duplicates        Feedback[]         @relation("duplicate-feedback")
  feedbackNotes     FeedbackNote[]
  feedbackAuditLogs FeedbackAuditLog[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([duplicateId])
}

model FeedbackNote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message    String
  userFacing Boolean @default(false)

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  feedbackId String
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId    String?

  @@index([feedbackId])
}

model FeedbackAuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeDescription String // EX: "Status change: new -> triaged"

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  feedbackId String
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId    String?

  @@index([feedbackId])
}

//
// user notifications
//
// Indexed via hand-written partial indexes in the
// add_notification_indexes migration (Prisma's @@index doesn't support
// WHERE clauses), scoped to the actual query patterns:
//   - unread badge count:  userId          WHERE read = false AND dismissed = false
//   - Unread tab:          userId, createdAt WHERE dismissed = false
//   - History tab:         userId, createdAt WHERE dismissed = true
// Review migration diffs on future schema changes to this model -- `prisma
// migrate dev` will try to drop these since they aren't expressible here.
model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title        String
  description  String?
  icon         String?
  referenceUrl String?

  read      Boolean @default(false)
  dismissed Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

//
// User-customizable app settings
//
model AccountSetting {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug                 String                @unique
  name                 String                @unique
  description          String
  defaultValue         String?
  accountSettingValues AccountSettingValue[]
}

model AccountSettingValue {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  value String

  accountSetting   AccountSetting @relation(fields: [accountSettingId], references: [id], onDelete: Cascade)
  accountSettingId String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String

  @@unique([accountSettingId, userId])
}

//
// Audit Logs
//
model CommunicationAuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communicationType CommunicationType
  from              String? // email address, phone number, etc
  to                String // email address, phone number, etc
  thirdPartyId      String? // resend email id, etc
  subject           String?
  content           String?

  // Assigned when this communicated was initiated by an admin
  initiatedBy       User?   @relation("initiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  initiatedByUserId String?

  user   User   @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
  @@index([initiatedByUserId, createdAt])
  @@index([communicationType, createdAt])
  @@index([subject, createdAt])
  @@index([createdAt])
}

enum CommunicationType {
  email
}

//
// Core models
//
model GearCategory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  public Boolean @default(false)

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String?
  gearInventoryItems GearInventoryItem[]

  // Full Text Search
  data_fts         Unsupported("tsvector GENERATED ALWAYS AS (to_tsvector('english', coalesce(name, ''))) STORED")?
  packingListItems PackingListItem[]

  @@index([data_fts], type: Gin)
}

model GearInventoryItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  quantity Int    @default(1)
  grams    Int?

  category       GearCategory @relation(fields: [gearCategoryId], references: [id])
  gearCategoryId String

  owner            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  packingListItems PackingListItem[]

  @@index([userId])
}

model PackingList {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  public Boolean @default(false)

  sourceUrl               String?
  description             String?
  copiedFromPackingListId String?

  owner               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String?
  packingListSections PackingListSection[]
  tripPackingLists    TripPackingList[]

  @@index([userId])
}

model PackingListSection {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  sortPosition Int

  packingList   PackingList       @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  packingListId String
  items         PackingListItem[]

  @@unique([name, packingListId])
}

model PackingListItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                String
  quantity            Int     @default(1)
  optional            Boolean @default(false)
  sortPosition        Int
  trackGearAssignment Boolean @default(true)

  category                    GearCategory?               @relation(fields: [gearCategoryId], references: [id])
  gearCategoryId              String?
  assignedGear                GearInventoryItem?          @relation(fields: [assignedGearId], references: [id])
  assignedGearId              String?
  packingListSection          PackingListSection?         @relation(fields: [packingListSectionId], references: [id], onDelete: Cascade)
  packingListSectionId        String?
  tripPackingListItemStatuses TripPackingListItemStatus[]

  @@unique([name, packingListSectionId])
}

model Trip {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  status   TripStatus @default(planning)
  trail    String?
  location String?
  start    DateTime?  @db.Date
  end      DateTime?  @db.Date

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  tasks          TripTask[]
  mealPlanDays   MealPlanDay[]
  links          TripLink[]
  packingList    TripPackingList?
  files          File[]
  partyMembers   TripPartyMember[]
  tripSafetyInfo TripSafetyInfo?

  // Covers status alone or status + start
  @@index([status, start])
  // Covers start alone for sorting
  @@index([start])
  // Covers planned composite search of these three fields
  @@index([name, trail, location])
  @@index([userId])
}

enum TripStatus {
  in_progress
  planning
  postponed
  finished
  cancelled
}

model TripTask {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  complete Boolean       @default(false)
  phase    TripTaskPhase
  dueDate  DateTime?     @db.Date

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String
}

enum TripTaskPhase {
  before
  during
  after
}

model TripLink {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  url         String
  name        String?
  description String?
  imageUrl    String?
  type        String?
  siteName    String?
  audioUrl    String?
  videoUrl    String?

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String

  @@unique([url, tripId])
}

model MealPlanDay {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dayNumber Int
  date      DateTime? @db.Date

  trip   Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String
  items  MealPlanDayItem[]

  @@unique([tripId, dayNumber])
}

enum MealName {
  breakfast
  lunch
  dinner
  snacks
}

// Reusable, per-user canonical meal-plan item (BTP-104). Editing a field
// here ripples to every placement; forking (see meal-plan router) creates a
// new row instead.
model MealPlanItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  brand          String?
  calories       Int
  waterMl        Int?
  dryWeightGrams Int?

  owner    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  dayItems MealPlanDayItem[]

  // Provenance for BTP-111's fork-on-add: set when this row was created by
  // forking a PublicMealItem. Nullable -- most MealPlanItem rows aren't forks.
  publicMealSource   PublicMealItem? @relation(fields: [publicMealSourceId], references: [id], onDelete: SetNull)
  publicMealSourceId String?

  // Full Text Search
  data_fts Unsupported("tsvector")?

  @@unique([userId, publicMealSourceId])
  @@index([userId])
  @@index([publicMealSourceId])
  @@index([data_fts], type: Gin)
}

// One placement of a MealPlanItem on one MealPlanDay/meal slot, with its own
// quantity and packing status. Placing an already-placed item in the same
// day+meal slot again bumps quantity (see meal-plan router) rather than
// creating a second row -- enforced by the unique constraint below.
// Deleting this row removes the placement only; the canonical MealPlanItem
// persists.
model MealPlanDayItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meal      MealName
  quantity  Int      @default(1)
  purchased Boolean  @default(false)
  packed    Boolean  @default(false)

  mealPlanDay    MealPlanDay  @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  mealPlanDayId  String
  mealPlanItem   MealPlanItem @relation(fields: [mealPlanItemId], references: [id], onDelete: Cascade)
  mealPlanItemId String

  @@unique([mealPlanDayId, mealPlanItemId, meal])
  @@index([mealPlanDayId])
  @@index([mealPlanItemId])
}

// Curated catalog of meals scraped from third-party vendor sites (BTP-107),
// browsable/forkable by any user (BTP-111). Scraped fields are
// nullable because a source page may not expose everything -- the import job
// (app/jobs/workers/public-meal-catalog) never blanks out a previously-known
// value on re-scrape, so a gap here means it's never successfully been parsed
// nor fixed by an admin (BTP-110, not yet built).
model PublicMealItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  brand          String?
  calories       Int?
  waterMl        Int?
  dryWeightGrams Int?

  image            Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId          String?
  // Last-seen image URL from the source. Compared against the current scrape
  // so an unchanged image is never re-downloaded/re-uploaded on every run.
  sourceImageUrl   String?
  // Admin-set replacement photo URL (BTP-136). Persists across import runs
  // as long as sourceImageUrl doesn't change -- mergePublicMealItem clears
  // this the moment the vendor's own source image url moves, since at that
  // point the override is stale and the fresh scrape should win.
  overrideImageUrl String?

  sourceVendor    String // e.g. "peak_refuel"
  sourceProductId String // vendor's own product id -- the upsert key together with sourceVendor
  sourceUrl       String // product page link, shown to an admin for cross-reference

  forkedMealPlanItems MealPlanItem[]

  // Full Text Search
  data_fts Unsupported("tsvector")?

  @@unique([sourceVendor, sourceProductId])
  @@index([data_fts], type: Gin)
}

model IgnoredPublicMealItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceVendor    String // Same as PublicMealItem.sourceVendor
  sourceProductId String // Same as PublicMealItem.sourceProductId

  ignoredBy   User   @relation(fields: [ignoredById], references: [id]) // Admin who marked the meal as ignored
  ignoredById String

  @@unique([sourceVendor, sourceProductId])
}

// A single stored image, backed by an object in Cloudflare R2. Currently only
// referenced by PublicMealItem; kept as its own model rather than inlined
// fields so other features can reuse it later without a schema change.
model Image {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  r2Key       String @unique
  contentType String
  width       Int
  height      Int

  publicMealItems PublicMealItem[]
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  r2Key       String @unique
  contentType String
  filename    String
  bytes       Int

  trip   Trip?   @relation(fields: [tripId], references: [id])
  tripId String?

  @@unique([tripId, filename])
}

model TripPackingList {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip                        Trip                        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId                      String                      @unique
  packingList                 PackingList                 @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  packingListId               String
  tripPackingListItemStatuses TripPackingListItemStatus[]

  @@index(packingListId)
}

model TripPackingListItemStatus {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packed    Boolean @default(false)
  notNeeded Boolean @default(false)

  tripPackingList   TripPackingList @relation(fields: [tripPackingListId], references: [id], onDelete: Cascade)
  tripPackingListId String
  packingListItem   PackingListItem @relation(fields: [packingListItemId], references: [id], onDelete: Cascade)
  packingListItemId String

  @@unique([tripPackingListId, packingListItemId])
}

model TripPartyMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String?
  phone String?
  email String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String

  @@index(tripId)
}

model TripSafetyInfo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emergencyContactName  String?
  emergencyContactPhone String?
  rangerStationName     String?
  rangerStationPhone    String?
  expectedDepartureTime String?
  epxectedReturnTime    String?
  vehicleDescription    String?
  permitOrRouteNumber   String?
  medicalNotes          String?

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String @unique
}

//
// Protected area inventory (PAD-US ingest)
//
enum ProtectedAreaCategory {
  fee
  designation
  easement
  proclamation
  marine
  other
  unknown
}

model ProtectedArea {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The GDB's OBJECTID (ESRI FID) for this record, used as the upsert key.
  // PAD-US has no field that is both populated and unique across all rows
  // (Source_PAID is blank on ~36% of rows and not unique on the rest) --
  // OBJECTID is unique within a given export but not guaranteed stable
  // across a future PAD-US release, so re-ingesting a new release may
  // produce duplicate rows rather than clean updates. True cross-release/
  // cross-source identity resolution is BTP-68's job.
  sourceUniqueId String @unique

  unitName  String // Unit_Nm
  localName String? // Loc_Nm
  category  ProtectedAreaCategory // Category

  managerType      String? // Mang_Type
  managerName      String? // Mang_Name
  ownerType        String? // Own_Type
  ownerName        String? // Own_Name
  designationType  String? // Des_Tp
  localDesignation String? // Loc_Ds

  gapStatus       String? // GAP_Sts
  iucnCategory    String? // IUCN_Cat
  publicAccess    String? // Pub_Access
  dateEstablished Int? // Date_Est (year)
  acres           Float? // GIS_Acres

  aggregatorSource String // Agg_Src, e.g. "PADUS4_1" -- which release this row came from
  wdpaCode         String? // WDPA_Cd -- future international join key, kept for provenance even though unused now

  state     String? // 2-letter USPS code
  latitude  Float? // computed centroid, not the source boundary
  longitude Float?

  // Crosswalk rows pointing at this raw record (the PADUS_OBJECTID entries).
  // Lets the canonical Place read source detail through the relation.
  placeSourceIds PlaceSourceId[]

  @@index([unitName])
  @@index([state])
}

enum ProtectedAreaIngestStatus {
  running
  succeeded
  failed
}

model ProtectedAreaIngestRun {
  id    String  @id @default(uuid())
  jobId String? // BullMQ job id, for cross-referencing Bull Board

  source String // e.g. "PAD-US 4.1 Combined" -- what was ingested
  status ProtectedAreaIngestStatus @default(running)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  itemsProcessed Int @default(0)
  itemsCreated   Int @default(0)
  itemsUpdated   Int @default(0)

  errorMessage String? // populated on failure, mirrors what's logged to winston

  initiatedBy       User?   @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  initiatedByUserId String?

  @@index([status, startedAt])
}

//
// Canonical entity model + source-ID crosswalk (BTP-68)
//
// The canonical layer (Place) sits above raw per-source records (currently
// only ProtectedArea / PAD-US). Place is intentionally thin -- just the fields
// needed to find and disambiguate an entity (name, state, publicAccess). Rich
// attributes (acres, category, GAP status, manager, geometry, ...) are NOT
// duplicated here; they're read from the source record(s) through the
// crosswalk relation (place -> sourceIds -> protectedArea).
//
// All entity<->source linkage lives on PlaceSourceId. Dedup IS implemented for
// PAD-US: the derivation job (derive-canonical-entities) groups source rows by
// exact normalized name + state into one Place, so the same physical unit
// spread across PAD-US's Fee/Designation/Proclamation/Marine/Easement feature
// classes collapses to a single canonical entity with one crosswalk row per
// source OID. A future source attaches by adding crosswalk rows -- no schema
// change required.

enum SourceIdType {
  WDPA_Cd // WDPA_Cd -- future international join key
  PADUS_OBJECTID // PAD-US OBJECTID (== ProtectedArea.sourceUniqueId)
  NPS_parkCode // reserved for BTP-67
  RIDB_FacilityID // reserved for RIDB
}

model Place {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String // representative Unit_Nm for the merged group
  state        String? // 2-letter USPS code
  publicAccess String? // most-permissive Pub_Access across the group, mapped to a word (Open/Restricted/Unknown/Closed)

  // Backpacking relevance for search ranking, best across the merged group.
  // 3 = federal/state public land, 2 = local/district, 1 = other open land,
  // 0 = closed access / private parks / private-NGO easements (demoted). See
  // the derivation job for the exact rules.
  backpackingTier Int    @default(0)
  acres           Float? // largest GIS_Acres across the group (ranking tiebreak / display)

  sourceIds PlaceSourceId[]

  // Full text search over name -- populated by a BEFORE INSERT OR UPDATE
  // trigger (see the migration), mirroring GearCategory.
  data_fts Unsupported("tsvector")?

  @@index([state])
  @@index([name])
  @@index([data_fts], type: Gin)
}

model PlaceSourceId {
  id      String @id @default(uuid())
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId String

  idType  SourceIdType
  idValue String
  source  String // provenance, e.g. "PAD-US 4.1"

  // Direct relation to the raw source record, so Place can read source detail
  // through the crosswalk. Set on PADUS_OBJECTID rows; null for identity-only
  // rows (e.g. WDPA_Cd) and future non-ProtectedArea sources.
  protectedArea   ProtectedArea? @relation(fields: [protectedAreaId], references: [id], onDelete: Cascade)
  protectedAreaId String?

  // A given source ID resolves to exactly one canonical Place.
  @@unique([idType, idValue])
  @@index([placeId])
  @@index([protectedAreaId])
}
