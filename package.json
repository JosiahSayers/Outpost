{
  "name": "outpost",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "[ \"$NODE_ENV\" != \"ci\" ] && docker compose -f docker-compose.dev.yml up -d || echo \"skipped predev\"",
    "dev": "VERSION=$(cat version) NODE_ENV=development bun --watch index.ts",
    "dev:workers": "NODE_ENV=development bun --watch app/jobs/workers/index.ts",
    "email:dev": "email dev --dir app/emails",
    "db:reset": "bunx --bun prisma migrate reset && bun db:migrate && bun db:seed",
    "db:migrate": "bunx --bun prisma migrate dev && bunx --bun prisma generate",
    "db:seed": "bun prisma/seeds",
    "docker:publish": "docker buildx build --build-arg BUILD_VERSION=$(cat version) --build-arg COMMIT_SHA=$(git rev-parse HEAD) --push --platform linux/amd64 -t josiahsayers15/$npm_package_name:latest -t josiahsayers15/$npm_package_name:$(cat version) .",
    "start": "bunx --bun prisma migrate deploy && bun run db:seed && bun run --preload /usr/src/app/utils/sentry.ts /usr/src/app/index.ts",
    "start:workers": "bun run --preload /usr/src/app/utils/sentry.ts /usr/src/app/app/jobs/workers/index.ts",
    "test:unit": "bun test tests/unit tests/component",
    "test:integration": "bun test --preload ./tests/integration-preload.ts tests/integration",
    "test:all": "bun run test:unit && bun run test:integration",
    "test:e2e": "playwright test",
    "format": "prettier . --write",
    "format:check": "prettier . -c",
    "deploy:staging": "ssh outpost-staging 'docker compose up -d --pull always'",
    "typecheck": "bun tsc --noEmit",
    "branch:reset": "bun scripts/reset-branch-for-new-card.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@happy-dom/global-registrator": "^20.11.1",
    "@playwright/test": "^1.62.0",
    "@react-email/ui": "^6.9.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/luxon": "^3.7.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.24",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "react-email": "^6.9.1",
    "supertest": "^7.2.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@bull-board/api": "^8.3.2",
    "@bull-board/express": "^8.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.5.0",
    "@mantine/dates": "^9.5.0",
    "@mantine/form": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/components": "^1.0.12",
    "@sentry/bun": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/express": "^5.0.6",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.2",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.1",
    "express": "^5.2.1",
    "express-zod-safe": "^3.2.1",
    "luxon": "^3.7.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.0",
    "winston": "^3.19.0",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  }
}
